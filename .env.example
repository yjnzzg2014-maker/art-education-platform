# JWT Secret (必须 >= 32 字符，生产环境必须修改)
JWT_SECRET=<run: openssl rand -base64 32>
JWT_REFRESH_SECRET=<run: openssl rand -base64 32>

# MiniMax API Key (可选，不填则使用 Mock 模式)
MINIMAX_API_KEY=

# 数据库设置加密密钥 (用于加密存储在数据库中的 API Key)
SETTINGS_ENCRYPTION_KEY=<run: openssl rand -base64 32>

# 服务器端口
PORT=8085
# 允许的前端来源 (生产环境必须设为实际域名)
ALLOWED_ORIGIN=http://localhost:8086
